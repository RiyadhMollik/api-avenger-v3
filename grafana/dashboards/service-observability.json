{
  "dashboard": {
    "title": "CareForAll - Service Observability",
    "tags": ["careforall", "logs", "observability"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Total Logs",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "refId": "A",
            "metrics": [{"type": "count", "id": "1"}],
            "bucketAggs": [],
            "query": "*"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Error Count",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "refId": "A",
            "metrics": [{"type": "count", "id": "1"}],
            "bucketAggs": [],
            "query": "level:ERROR"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 10},
                {"color": "red", "value": 50}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Active Services",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "refId": "A",
            "metrics": [{"type": "cardinality", "field": "service.keyword", "id": "1"}],
            "bucketAggs": [],
            "query": "*"
          }
        ]
      },
      {
        "id": 4,
        "title": "Logs Over Time",
        "type": "graph",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 4},
        "targets": [
          {
            "refId": "A",
            "metrics": [{"type": "count", "id": "1"}],
            "bucketAggs": [
              {"type": "date_histogram", "field": "@timestamp", "id": "2", "settings": {"interval": "auto"}}
            ],
            "query": "*"
          }
        ],
        "yaxes": [
          {"label": "Count", "show": true},
          {"show": true}
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2
      },
      {
        "id": 5,
        "title": "Logs by Service",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "targets": [
          {
            "refId": "A",
            "metrics": [{"type": "count", "id": "1"}],
            "bucketAggs": [
              {"type": "terms", "field": "service.keyword", "id": "2", "settings": {"size": "10", "order": "desc"}}
            ],
            "query": "*"
          }
        ]
      },
      {
        "id": 6,
        "title": "Logs by Level",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "targets": [
          {
            "refId": "A",
            "metrics": [{"type": "count", "id": "1"}],
            "bucketAggs": [
              {"type": "terms", "field": "level.keyword", "id": "2", "settings": {"size": "10", "order": "desc"}}
            ],
            "query": "*"
          }
        ]
      },
      {
        "id": 7,
        "title": "Recent Errors",
        "type": "table",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 20},
        "targets": [
          {
            "refId": "A",
            "metrics": [{"type": "logs", "id": "1"}],
            "bucketAggs": [],
            "query": "level:ERROR"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "indexByName": {},
              "renameByName": {
                "@timestamp": "Time",
                "service": "Service",
                "message": "Message",
                "level": "Level"
              }
            }
          }
        ]
      }
    ],
    "schemaVersion": 38,
    "version": 1,
    "refresh": "5s"
  },
  "overwrite": true
}
