{
  "name": "careforall-platform",
  "version": "1.0.0",
  "description": "CareForAll Donation Platform - Microservices Architecture",
  "private": true,
  "workspaces": [
    "services/*",
    "shared/*"
  ],
  "scripts": {
    "install:all": "npm install && npm install --workspaces",
    "dev": "concurrently \"npm run dev --workspace=services/api-gateway\" \"npm run dev --workspace=services/auth-service\" \"npm run dev --workspace=services/campaign-service\" \"npm run dev --workspace=services/pledge-service\" \"npm run dev --workspace=services/payment-service\" \"npm run dev --workspace=services/totals-service\" \"npm run dev --workspace=services/notification-service\" \"npm run dev --workspace=services/admin-service\"",
    "test": "npm test --workspaces",
    "test:integration": "jest --config jest.integration.config.js",
    "test:load": "k6 run tests/load/scenario.js",
    "migrate:all": "npm run migrate --workspaces",
    "seed": "node scripts/seed-data.js",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "lint": "eslint services/** shared/**",
    "lint:fix": "eslint services/** shared/** --fix"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
